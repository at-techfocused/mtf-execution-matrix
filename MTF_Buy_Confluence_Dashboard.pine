// ═══════════════════════════════════════════════════════════════════
// PART 1: SCRIPT METADATA
// ═══════════════════════════════════════════════════════════════════
//@version=5
indicator("MTF Buy Confluence Dashboard",
  shorttitle="MTF-BCD",
  overlay=true,
  max_lines_count=10,
  max_labels_count=10,
  max_boxes_count=5)

// --- Color Constants ---
color COLOR_BG       = color.new(#2A2E39, 0)
color COLOR_HEADER   = color.new(#1E222D, 0)
color COLOR_GREEN    = color.new(#4CAF50, 0)
color COLOR_RED      = color.new(#FF5252, 0)
color COLOR_BLUE     = color.new(#2196F3, 0)
color COLOR_ORANGE   = color.new(#FFA726, 0)
color COLOR_SEP      = color.new(#363A45, 0)

// ═══════════════════════════════════════════════════════════════════
// PART 2: USER INPUTS
// ═══════════════════════════════════════════════════════════════════

// --- MACD Settings ---
fast_length   = input.int(12, "Fast Length",   group="MACD Settings")
slow_length   = input.int(25, "Slow Length",   group="MACD Settings")
signal_length = input.int(5,  "Signal Length", group="MACD Settings")

// --- EMA Settings ---
ema_fast = input.int(13, "Fast EMA Period",      group="EMA Settings")
ema_slow = input.int(34, "Slow EMA Period",      group="EMA Settings")
sma_50   = input.int(50, "SMA Period (Daily)",   group="EMA Settings")
ema_8    = input.int(8,  "Short EMA (Daily)",    group="EMA Settings")
ema_20   = input.int(20, "Mid EMA (Daily)",      group="EMA Settings")

// --- Market Context ---
vix_symbol      = input.symbol("CBOE:VIX",  "VIX Symbol",            group="Market Context")
vix_threshold   = input.float(20.0,         "VIX Safe Zone Threshold", group="Market Context")
nylow_symbol    = input.symbol("NYSE:LOWN", "NYSE New Lows Symbol",   group="Market Context")
// If NYSE:LOWN is unavailable, replace with INDEX:NYLOW
nylow_threshold = input.int(500, "NYSE New Lows Threshold", group="Market Context")

// --- Confidence Score Toggles ---
inc_01 = input.bool(true, "Include 13W MA Rising in Score",        group="Confidence Score")
inc_02 = input.bool(true, "Include 34W MA Rising in Score",        group="Confidence Score")
inc_03 = input.bool(true, "Include 13W EMA > 34W EMA in Score",    group="Confidence Score")
inc_04 = input.bool(true, "Include W MACD Hist Rising in Score",   group="Confidence Score")
inc_05 = input.bool(true, "Include D MACD Hist Rising in Score",   group="Confidence Score")
inc_06 = input.bool(true, "Include 8D EMA > 20D EMA in Score",     group="Confidence Score")
inc_07 = input.bool(true, "Include Price > 13W EMA in Score",      group="Confidence Score")
inc_08 = input.bool(true, "Include Price > 50D SMA in Score",      group="Confidence Score")
inc_09 = input.bool(true, "Include MACD(12,25,5) Pos in Score",    group="Confidence Score")
inc_10 = input.bool(true, "Include Elder W Not Red in Score",      group="Confidence Score")
inc_11 = input.bool(true, "Include Elder D Not Red in Score",      group="Confidence Score")

// --- Overlay 2: Manual Anchor Trendlines (Wedge) ---
upper_bar1   = input.int(0,   "Upper Trendline Anchor 1 Bar",   group="Trendlines")
upper_price1 = input.float(0, "Upper Trendline Anchor 1 Price", group="Trendlines")
upper_bar2   = input.int(0,   "Upper Trendline Anchor 2 Bar",   group="Trendlines")
upper_price2 = input.float(0, "Upper Trendline Anchor 2 Price", group="Trendlines")
lower_bar1   = input.int(0,   "Lower Trendline Anchor 1 Bar",   group="Trendlines")
lower_price1 = input.float(0, "Lower Trendline Anchor 1 Price", group="Trendlines")
lower_bar2   = input.int(0,   "Lower Trendline Anchor 2 Bar",   group="Trendlines")
lower_price2 = input.float(0, "Lower Trendline Anchor 2 Price", group="Trendlines")

// --- Overlay 3: Key Horizontal Level ---
key_level = input.float(0.0, "Key Horizontal Level", group="Key Level")

// --- Overlay 4: Measurement Label ---
anchor_bar1   = input.int(0,   "Measurement Anchor 1 Bar",   group="Measurement")
anchor_price1 = input.float(0, "Measurement Anchor 1 Price", group="Measurement")
anchor_bar2   = input.int(0,   "Measurement Anchor 2 Bar",   group="Measurement")
anchor_price2 = input.float(0, "Measurement Anchor 2 Price", group="Measurement")

// --- Overlay 5: Volume-by-Price Approximation ---
vpvr_lookback = input.int(100, "VPVR Lookback Bars", minval=10, group="Volume Profile")

// ═══════════════════════════════════════════════════════════════════
// PART 3: MULTI-TIMEFRAME CALCULATIONS
// ═══════════════════════════════════════════════════════════════════

// --- WEEKLY TIMEFRAME ---

// Weekly 13 EMA (Fast EMA on weekly timeframe)
W_ema13 = request.security(syminfo.tickerid, "W",
  ta.ema(close, ema_fast),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Weekly 34 EMA (Slow EMA on weekly timeframe)
W_ema34 = request.security(syminfo.tickerid, "W",
  ta.ema(close, ema_slow),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Weekly MACD (custom 12/25/5 on weekly timeframe)
[W_macd_line, W_signal_line, W_hist] = request.security(syminfo.tickerid, "W",
  ta.macd(close, fast_length, slow_length, signal_length),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Weekly derived signals
W_13MA_rising = W_ema13[0] > W_ema13[1]
W_34MA_rising = W_ema34[0] > W_ema34[1]
W_ema_cross   = W_ema13 > W_ema34
W_macd_rising = W_hist[0] > W_hist[1]

// --- DAILY TIMEFRAME ---

// Daily 8 EMA (Short EMA on daily timeframe)
D_ema8 = request.security(syminfo.tickerid, "D",
  ta.ema(close, ema_8),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Daily 20 EMA (Mid EMA on daily timeframe)
D_ema20 = request.security(syminfo.tickerid, "D",
  ta.ema(close, ema_20),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Daily 50 SMA (on daily timeframe)
D_sma50 = request.security(syminfo.tickerid, "D",
  ta.sma(close, sma_50),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Daily 13 EMA (Fast EMA on daily timeframe, for Elder and price comparison)
D_ema13 = request.security(syminfo.tickerid, "D",
  ta.ema(close, ema_fast),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Daily MACD (custom 12/25/5 on daily timeframe)
[D_macd_line, D_signal_line, D_hist] = request.security(syminfo.tickerid, "D",
  ta.macd(close, fast_length, slow_length, signal_length),
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Daily close for price comparisons (resolved on daily timeframe)
D_close = request.security(syminfo.tickerid, "D",
  close,
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)

// Daily derived signals
D_macd_rising = D_hist[0] > D_hist[1]
D_8_above_20  = D_ema8 > D_ema20
D_price_ema13 = D_close > D_ema13
D_price_sma50 = D_close > D_sma50
D_macd_pos    = D_macd_line > 0

// --- ELDER IMPULSE SYSTEM (3-State, Weekly & Daily) ---

// Weekly Elder Impulse
W_elder_green = W_13MA_rising and W_macd_rising
W_elder_red   = (W_ema13[0] < W_ema13[1]) and (W_hist[0] < W_hist[1])
W_elder_blue  = not W_elder_green and not W_elder_red
W_elder_ok    = not W_elder_red  // "Not Red" condition

// Daily Elder Impulse
D_13MA_rising_elder = D_ema13[0] > D_ema13[1]
D_elder_green = D_13MA_rising_elder and D_macd_rising
D_elder_red   = (D_ema13[0] < D_ema13[1]) and (D_hist[0] < D_hist[1])
D_elder_blue  = not D_elder_green and not D_elder_red
D_elder_ok    = not D_elder_red

// --- MARKET CONTEXT (Global — not ticker-specific) ---

// VIX daily close (market-wide fear gauge)
vix_close = request.security(vix_symbol, "D",
  close,
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)
vix_safe = vix_close < vix_threshold

// NYSE New Lows daily close (breadth indicator)
// If NYSE:LOWN is unavailable, replace with INDEX:NYLOW
nylow_close = request.security(nylow_symbol, "D",
  close,
  gaps=barmerge.gaps_off,
  lookahead=barmerge.lookahead_off)
nylow_safe = nylow_close < nylow_threshold

// ═══════════════════════════════════════════════════════════════════
// PART 4: CONFIDENCE SCORE LOGIC
// ═══════════════════════════════════════════════════════════════════

// 11 asset-specific boolean checks
checks = array.from(
  W_13MA_rising,    // "13W MA Rising"
  W_34MA_rising,    // "34W MA Rising"
  W_ema_cross,      // "13W EMA > 34W EMA"
  W_macd_rising,    // "W MACD Hist Rising"
  D_macd_rising,    // "D MACD Hist Rising"
  D_8_above_20,     // "8D EMA > 20D EMA"
  D_price_ema13,    // "Price > 13W EMA"
  D_price_sma50,    // "Price > 50D SMA"
  D_macd_pos,       // "MACD(12,25,5) Pos"
  W_elder_ok,       // "Elder W Not Red"
  D_elder_ok        // "Elder D Not Red"
  )

labels = array.from(
  "13W MA Rising", "34W MA Rising", "13W EMA > 34W EMA",
  "W MACD Hist Rising", "D MACD Hist Rising", "8D EMA > 20D EMA",
  "Price > 13W EMA", "Price > 50D SMA", "MACD(12,25,5) Pos",
  "Elder W Not Red", "Elder D Not Red"
  )

// Toggle array for include/exclude
toggles = array.from(inc_01, inc_02, inc_03, inc_04, inc_05, inc_06, inc_07, inc_08, inc_09, inc_10, inc_11)

// Confidence calculation
int passed = 0
int total  = 0
for i = 0 to 10
    if array.get(toggles, i)
        total += 1
        if array.get(checks, i)
            passed += 1

confidence_pct = total > 0 ? math.round((passed / total) * 100) : 0

// Market context checks (do NOT contribute to confidence_pct)
market_checks = array.from(vix_safe, nylow_safe)
market_labels = array.from("VIX in Safe Zone", "NYSE New Lows < 500")

// ═══════════════════════════════════════════════════════════════════
// PART 5: TABLE / DASHBOARD UI
// ═══════════════════════════════════════════════════════════════════

var table dashboard = table.new(position.top_right, 2, 16,
  bgcolor=COLOR_BG,
  border_width=1,
  border_color=COLOR_SEP,
  frame_color=COLOR_SEP,
  frame_width=1)

if barstate.islast
    // Row 0: Header
    table.cell(dashboard, 0, 0, "BUYING CHECKLIST: " + syminfo.ticker,
      bgcolor=COLOR_HEADER, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 0, "STATUS",
      bgcolor=COLOR_HEADER, text_color=color.white, text_size=size.small, text_halign=text.align_center)

    // Rows 1–11: Asset checks
    for i = 0 to 10
        bool chk = array.get(checks, i)
        string lbl = array.get(labels, i)
        string status_txt = chk ? "✔" : "✘"
        color status_bg   = chk ? COLOR_GREEN : COLOR_RED
        table.cell(dashboard, 0, i + 1, lbl,
          bgcolor=COLOR_BG, text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, i + 1, status_txt,
          bgcolor=status_bg, text_color=color.white, text_size=size.small, text_halign=text.align_center)

    // Row 12: Separator
    table.cell(dashboard, 0, 12, "--- MARKET CONTEXT ---",
      bgcolor=COLOR_SEP, text_color=color.gray, text_size=size.small, text_halign=text.align_center)
    table.cell(dashboard, 1, 12, "",
      bgcolor=COLOR_SEP, text_color=color.gray, text_size=size.small)
    table.merge_cells(dashboard, 0, 12, 1, 12)

    // Rows 13–14: Market context checks
    for j = 0 to 1
        bool mchk = array.get(market_checks, j)
        string mlbl = array.get(market_labels, j)
        string mstatus = mchk ? "✔" : "✘"
        color mbg      = mchk ? COLOR_GREEN : COLOR_RED
        table.cell(dashboard, 0, j + 13, mlbl,
          bgcolor=COLOR_BG, text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, j + 13, mstatus,
          bgcolor=mbg, text_color=color.white, text_size=size.small, text_halign=text.align_center)

    // Row 15: Confidence footer
    color conf_bg = confidence_pct >= 80 ? COLOR_GREEN : confidence_pct >= 50 ? COLOR_ORANGE : COLOR_RED
    table.cell(dashboard, 0, 15, "OVERALL CONFIDENCE",
      bgcolor=conf_bg, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dashboard, 1, 15, str.tostring(confidence_pct) + "%",
      bgcolor=conf_bg, text_color=color.white, text_size=size.small, text_halign=text.align_center)

// ═══════════════════════════════════════════════════════════════════
// PART 6: CHART OVERLAYS
// ═══════════════════════════════════════════════════════════════════

// --- OVERLAY 1: Moving Averages ---
plot(W_ema13, "W EMA 13", color=#9C27B0, linewidth=2)
plot(W_ema34, "W EMA 34", color=#2196F3, linewidth=2)
plot(D_sma50, "D SMA 50", color=#FF9800, linewidth=1, style=plot.style_line)

// --- OVERLAY 2: Manual Anchor Trendlines (Wedge) ---
var line upper_trend = na
var line lower_trend = na

if barstate.islast
    // Clean up previous lines
    if not na(upper_trend)
        line.delete(upper_trend)
    if not na(lower_trend)
        line.delete(lower_trend)

    // Draw upper trendline if anchors are set
    if upper_bar1 != 0 and upper_bar2 != 0
        upper_trend := line.new(upper_bar1, upper_price1, upper_bar2, upper_price2,
          color=#FF5252, width=2, extend=extend.right)

    // Draw lower trendline if anchors are set
    if lower_bar1 != 0 and lower_bar2 != 0
        lower_trend := line.new(lower_bar1, lower_price1, lower_bar2, lower_price2,
          color=#4CAF50, width=2, extend=extend.right)

// --- OVERLAY 3: Key Horizontal Level ---
var line key_hline = na

if barstate.islast
    if not na(key_hline)
        line.delete(key_hline)
    if key_level > 0
        key_hline := line.new(bar_index - 1, key_level, bar_index, key_level,
          color=#FF5252, width=2, style=line.style_solid, extend=extend.both)

// --- OVERLAY 4: Measurement Label ---
var label meas_label = na

if barstate.islast
    if not na(meas_label)
        label.delete(meas_label)
    if anchor_bar1 != 0 and anchor_bar2 != 0 and anchor_price1 != 0
        float point_change = anchor_price2 - anchor_price1
        float pct_change   = (point_change / anchor_price1) * 100
        color lbl_color    = point_change > 0 ? COLOR_GREEN : COLOR_RED
        string lbl_text    = str.tostring(point_change, "#.##") + " (" + str.tostring(pct_change, "#.##") + "%)"
        meas_label := label.new(anchor_bar2, anchor_price2, lbl_text,
          style=label.style_label_left, color=lbl_color, textcolor=color.white, size=size.small)

// --- OVERLAY 5: Volume-by-Price Approximation ---
// TradingView's native VPVR is not accessible via Pine Script API.
// This implements a price-bucket approximation using box.new().
// Capped to max_boxes_count=5 buckets displayed (top 5 by volume).

var box[] vpvr_boxes = array.new_box(0)

if barstate.islast
    // Clean up previous boxes
    for b = 0 to array.size(vpvr_boxes) - 1
        box.delete(array.get(vpvr_boxes, b))
    array.clear(vpvr_boxes)

    // Determine price range over lookback
    float hi = ta.highest(high, vpvr_lookback)
    float lo = ta.lowest(low, vpvr_lookback)
    float rng = hi - lo

    if rng > 0
        int N = 20
        float bucket_size = rng / N

        // Accumulate volume into N buckets
        var float[] vol_buckets = array.new_float(N, 0.0)
        for k = 0 to N - 1
            array.set(vol_buckets, k, 0.0)

        for j = 0 to vpvr_lookback - 1
            float bar_mid = (high[j] + low[j]) / 2.0
            int idx = math.floor((bar_mid - lo) / bucket_size)
            if idx >= N
                idx := N - 1
            if idx < 0
                idx := 0
            array.set(vol_buckets, idx, array.get(vol_buckets, idx) + volume[j])

        // Find max volume for normalization
        float max_vol = 0.0
        for k = 0 to N - 1
            if array.get(vol_buckets, k) > max_vol
                max_vol := array.get(vol_buckets, k)

        // Find top 5 buckets by volume (limited by max_boxes_count=5)
        var int[] top_indices = array.new_int(0)
        array.clear(top_indices)
        var float[] sorted_vols = array.new_float(0)
        array.clear(sorted_vols)

        for k = 0 to N - 1
            array.push(sorted_vols, array.get(vol_buckets, k))

        // Simple selection of top 5
        for _iter = 0 to 4
            float best = 0.0
            int best_idx = -1
            for k = 0 to N - 1
                bool already_used = false
                for m = 0 to array.size(top_indices) - 1
                    if array.get(top_indices, m) == k
                        already_used := true
                        break
                if not already_used and array.get(vol_buckets, k) > best
                    best := array.get(vol_buckets, k)
                    best_idx := k
            if best_idx >= 0
                array.push(top_indices, best_idx)

        // Median volume for high/low threshold
        float vol_median = max_vol * 0.5

        // Draw boxes for top 5 buckets on left side of visible range
        int left_bar = bar_index - vpvr_lookback
        for t = 0 to array.size(top_indices) - 1
            int bi = array.get(top_indices, t)
            float bucket_lo = lo + bi * bucket_size
            float bucket_hi = bucket_lo + bucket_size
            float bvol = array.get(vol_buckets, bi)
            // Width proportional to volume
            int box_width = math.round((bvol / max_vol) * (vpvr_lookback / 2))
            if box_width < 1
                box_width := 1
            color box_col = bvol >= vol_median ? color.new(#F9A825, 60) : color.new(#1565C0, 60)
            array.push(vpvr_boxes, box.new(left_bar, bucket_hi, left_bar + box_width, bucket_lo,
              bgcolor=box_col, border_color=box_col, border_width=1))

// ═══════════════════════════════════════════════════════════════════
// PART 7: ALERTS
// ═══════════════════════════════════════════════════════════════════

alertcondition(confidence_pct == 100,
  title="All Asset Checks Passed",
  message="MTF-BCD: All 11 asset checks passed — 100% confidence.")

alertcondition(confidence_pct >= 80,
  title="Confidence Above 80%",
  message="MTF-BCD: Confidence score is above 80%.")

alertcondition(not vix_safe,
  title="VIX Danger Zone",
  message="MTF-BCD: VIX has exceeded the safe zone threshold!")

alertcondition(W_elder_red,
  title="Elder Impulse Red (W)",
  message="MTF-BCD: Weekly Elder Impulse has turned RED.")

alertcondition(D_elder_red,
  title="Elder Impulse Red (D)",
  message="MTF-BCD: Daily Elder Impulse has turned RED.")
